<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0d28142d-bb89-476d-83a5-54fcb5163301</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Authorization\" />
  </ItemGroup>

  <!-- CoreOnly retira negocio del compilador; mantiene Program y migraciones reales. -->
  <PropertyGroup Condition="'$(Configuration)' == 'CoreOnly'">
    <DefineConstants>$(DefineConstants);CORE_ONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'CoreOnly'">
    <Compile Remove="Controllers/ReservasController.cs;Controllers/Reservas/**/*.cs;Services/Reservas/**/*.cs;DTOs/Reservas/**/*.cs;Data/Reservas/**/*.cs;Models/Reservas/**/*.cs;Hosting/Reservas/**/*.cs;Models/Reserva.cs;Models/Espacio.cs;Models/Enums/EstadoReserva.cs;Models/Enums/TipoEspacio.cs;Models/Enums/TransaccionesReserva.cs" />
  </ItemGroup>
</Project>
